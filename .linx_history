cat << 'EOF' > ~/LinxOS/core/extensions.sh
#!/usr/env/bin bash

# ==========================================
#  LinxOS Extensions & Vanilla GemiN9 Engine
#  Theme: Git-Style (Blue Background / White Text)
# ==========================================

# 1. Willkommens-Banner
gemin9_init() {
    clear
    echo -e "\033[44;\033[1;97m==================================================\033[0m"
    echo -e "\033[44;\033[1;97m   Vanilla GemiN9 Engine v1.0 [Git-Blue Edition]  \033[0m"
    echo -e "\033[44;\033[1;97m==================================================\033[0m"
    echo -e "\033[44;\033[97m[*]\033[93m git branch:\033[97m main"
    echo -e "\033[44;\033[97m[*]\033[92m status:\033[97m LinxOS läuft auf Termux-Basis 🚀"
    echo -e "\033[44;\033[97m--------------------------------------------------\033[0m"
    echo ""
}

# 2. Custom Prompt
export PS1='\[\033[44;\033[1;97m\][GN9@LinxOS \[\033[96m\]\w\[\033[97m\]]\$ \[\033[0m\]'

# 3. Helpers
sysinfo() {
    echo -e "\033[44;\033[1;97m=== GemiN9 Git-System Status ===\033[0m"
    echo -e "\033[44;\033[97mLinx Root: \033[93m$LINX_ROOT\033[0m"
    echo -e "\033[44;\033[97mZeit:       \033[97m$(date +'%H:%M:%S')\033[0m"
}

alias info='sysinfo'
alias gst='git status'
alias gpl='git pull origin main'
alias cls='clear && gemin9_init'

# Boot
gemin9_init
EOF

exit

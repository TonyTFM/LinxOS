#!/bin/bash
echo "Starte LinxMint / PRoot..."
# Wechsle ins Verzeichnis und starte die Shell
cd ~/LinxMint
# Falls du proot-distro nutzt:
if command -v proot-distro &> /dev/null; then
    proot-distro login debian
else
    # Manueller PRoot-Aufruf für das lokale Rootfs:
    proot -0 -r . -b /dev -b /sys -b /proc -b /sdcard /bin/bash
fi
EOF


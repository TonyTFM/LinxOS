#!/data/data/com.termux/files/usr/bin/bash

LINX_ROOT="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"

source "$LINX_ROOT/config/theme.conf"
source "$LINX_ROOT/core/system.sh"

clear

echo -e "${BLUE}"
echo "================================"
echo "            LinxOS"
echo "================================"
echo -e "${WHITE}"
echo " Android Linux Environment"
echo " Version: 0.1.0"
echo
echo " 1) Systeminformationen"
echo " 2) LinxOS aktualisieren"
echo " 3) Terminal"
echo " 4) Über LinxOS"
echo " 0) Beenden"
echo
echo -e "${BLUE}================================${WHITE}"

while true; do
    echo
    read -rp "LinxOS > " choice

    case "$choice" in
        1)
            linx_system
            ;;
        2)
            bash "$LINX_ROOT/core/update.sh"
            ;;
        3)
            echo "Du befindest dich jetzt in der LinxOS-Shell."
            echo "Mit 'exit' kehrst du zum Menü zurück."
            bash --norc --noprofile
            ;;
        4)
            echo "LinxOS 0.1.0"
            echo "Ein leichtgewichtiges Linux-Projekt für Android."
            ;;
        0)
            echo "LinxOS wird beendet."
            exit 0
            ;;
        *)
            echo "Unbekannter Befehl."
            ;;
    esac
done
#!/bin/bash
cd "$HOME/LinxOS" || exit 1

OUTPUT="$HOME/LinxOS-Master-$(date +%Y%m%d).tar.gz"

echo -e "\033[1;33m[+] Bundling exact LinxOS state (including compiled binaries)...\033[0m"

# Packt alles ein, ignoriert aber den .git-Ordner, damit es schlank bleibt
tar --exclude='.git' -czf "$OUTPUT" .

echo -e "\033[1;32m[✔] Master bundle ready: $OUTPUT\033[0m"
echo -e "\033[1;36m[i] Transfer this file to your other device, extract it, and run: ./install.sh\033[0m"

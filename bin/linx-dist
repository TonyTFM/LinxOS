#!/bin/bash
# LinxOS v1.1.0 - Portable Core Distro Exporter
TARGET="/sdcard/Download/LinxOS_Core_v1.1.0.tar.gz"

echo -e "\033[38;5;39m[LinxOS Distributer]\033[0m Building clean 120MB core package..."

# Packt nur Termux-Essentials + LinxOS Repo ohne schwere PRoot-Container
tar -czf "$TARGET" \
    --exclude="files/usr/var/lib/proot-distro" \
    -C /data/data/com.termux/files \
    home/LinxOS usr/bin usr/etc

echo -e "\033[38;5;82mPackage ready at: $TARGET\033[0m"

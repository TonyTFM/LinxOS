#!/usr/bin/env bash

TOKEN_FILE="/tmp/linx_root_auth"

echo -e "\033[40;\033[1;36m"
echo "=================================================="
echo "    LinxOS Security & Bootloader Manager          "
echo "=================================================="
echo -e "\033[40;\033[97m"
echo "1) Root-Sitzung sperren (Token löschen)"
echo "2) Bootloader-Status prüfen (GSI / A34 Check)"
echo "0) Zurück"
echo ""
read -p "Wähle eine Option: " choice

case $choice in
    1)
        if [ -f "$TOKEN_FILE" ]; then
            rm -f "$TOKEN_FILE"
            echo -e "\033[32m[GESPERRT] Permanentes Root-Token wurde gelöscht. Beim nächsten 'sudo -i' ist wieder das Rätsel fällig!\033[0m"
        else
            echo -e "\033[33m[INFO] Es ist aktuell kein permanentes Token aktiv.\033[0m"
        fi
        ;;
    2)
        echo -e "\033[36m[BOOTLOADER STATUS]\033[0m"
        echo "Device: Samsung Galaxy A34 5G (a34x)"
        echo "State:  UNLOCKED (verified via GSI / Download Mode)"
        echo "SELinux: Enforcing / Custom GSI Policy active"
        ;;
    *)
        echo "Abgebrochen."
        ;;
esac
